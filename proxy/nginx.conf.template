log_format myvita '$time_iso8601 client=$remote_addr method=$request_method '
                  'path=$uri status=$status duration=$request_time '
                  'upstream=$upstream_addr upstream_time=$upstream_response_time';

server {
    listen 8080;
    server_name ${PUBLIC_DOMAIN};
    server_tokens off;
    client_max_body_size 1m;

    access_log /dev/stdout myvita;
    error_log /dev/stderr warn;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    error_page 413 = @request_too_large;
    location @request_too_large {
        default_type application/json;
        return 413 '{"detail":"Pedido demasiado grande."}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /health {
        proxy_pass http://backend:8000/health;
        include /etc/nginx/proxy_params;
    }

    location = /ready {
        proxy_pass http://backend:8000/ready;
        include /etc/nginx/proxy_params;
    }

    # Metrics are collected through the internal-only metrics proxy. Never
    # let the SPA fallback make this path appear publicly available.
    location = /metrics {
        access_log off;
        return 404;
    }

    # Document uploads only: DOCUMENT_MAX_UPLOAD_BYTES (10 MiB) plus multipart
    # overhead, matching the backend's own body limit for this path. Every
    # other request keeps the 1m limit above. Raise both together.
    location ~ "^/api/v1/patients/[0-9a-fA-F-]{36}/documents$" {
        client_max_body_size 11m;
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy_params;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy_params;
    }

    location / {
        proxy_pass http://frontend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
