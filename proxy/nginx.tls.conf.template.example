log_format myvita '$time_iso8601 client=$remote_addr method=$request_method '
                  'path=$uri status=$status duration=$request_time '
                  'upstream=$upstream_addr upstream_time=$upstream_response_time';

server {
    listen 8080;
    server_name ${PUBLIC_DOMAIN};
    location = /healthz { access_log off; return 200 "ok\n"; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 8443 ssl;
    server_name ${PUBLIC_DOMAIN};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;

    access_log /dev/stdout myvita;
    error_log /dev/stderr warn;

    location = /healthz { access_log off; return 200 "ok\n"; }
    location = /health {
        proxy_pass http://backend:8000/health;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /ready {
        proxy_pass http://backend:8000/ready;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /api/ {
        proxy_pass http://backend:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        proxy_pass http://frontend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    }
}
