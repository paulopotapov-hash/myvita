# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# Sync psycopg driver — matches docker-compose service name "db" below.
DATABASE_URL=postgresql+psycopg://myvita:myvita@db:5432/myvita

# Generate a real secret for anything beyond local dev, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-real-secret

# Set to true and use https in staging/production.
COOKIE_SECURE=false

CORS_ORIGINS=["http://localhost:5173"]
