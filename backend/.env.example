# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# Sync psycopg driver — matches docker-compose service name "db" below.
DATABASE_URL=postgresql+psycopg://myvita:myvita@db:5432/myvita

# Generate a real secret for anything beyond local dev, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 bytes (RFC 7518 §3.2 minimum for HS256) — enforced at
# startup; anything shorter is rejected before the app will even boot.
JWT_SECRET_KEY=change-me-generate-a-real-secret-at-least-32-bytes-long

# Must be HS256, HS384 or HS512 — enforced at startup.
# JWT_ALGORITHM=HS256

# Set to true and use https in staging/production.
# REQUIRED true when ENVIRONMENT=production — app refuses to start otherwise.
COOKIE_SECURE=false

# REQUIRED explicit (no "*") when ENVIRONMENT=production — app refuses to
# start otherwise, since allow_credentials=True is incompatible with a
# wildcard origin.
CORS_ORIGINS=["http://localhost:5173"]
# CORS_ALLOW_METHODS=["GET","POST","PATCH","DELETE"]
# CORS_ALLOW_HEADERS=["Content-Type","X-CSRF-Token","X-Request-ID"]

# CSRF cookie/header names — defaults below are fine to leave as-is.
# CSRF_COOKIE_NAME=myvita_csrf
# CSRF_HEADER_NAME=X-CSRF-Token

# IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For. Leave unset
# (nothing trusted) unless the app runs behind a reverse proxy — see
# app/core/client_ip.py and README.md#production.
# TRUSTED_PROXIES=["172.16.0.0/12"]

# Enables GET /metrics (Prometheus text format) when set, and required as
# the X-Metrics-Token header on every request to it. Leave unset to keep
# /metrics returning 404 (the default — nothing exposed publicly).
# METRICS_TOKEN=
