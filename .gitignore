# Database dumps/backups — never belong in git, regardless of where the
# backup script is run from.
*.dump
*.sql
*.sql.gz
*.sha256
backups/
# Interrupted backup_db.sh runs leave .myvita_<ts>.dump.tmp.<rand> files.
*.dump.tmp.*
# Documents archives and their staging/temp files (backup_documents.sh).
*.tar.gz
.myvita_documents_*
.myvita-restore-*
*.sha256.tmp

.DS_Store
node_modules/
dist/
frontend/coverage/

# Playwright artifacts
frontend/test-results/
frontend/playwright-report/
frontend/e2e/.auth/

# Local document storage (development default DOCUMENT_STORAGE_DIR)
backend/var/documents/
