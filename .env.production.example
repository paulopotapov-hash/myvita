# Template only. Copy outside Git, replace every angle-bracket placeholder,
# chmod 0600, and preferably inject these values from an approved secret manager.
POSTGRES_USER=<INJECT_DATABASE_USER>
POSTGRES_PASSWORD=<INJECT_DATABASE_PASSWORD>
POSTGRES_DB=<INJECT_DATABASE_NAME>
# Least-privilege role the backend connects with (created/updated by the
# migrate service). Must differ from POSTGRES_USER.
APP_DB_ROLE=myvita_app
APP_DB_PASSWORD=<INJECT_RANDOM_RUNTIME_DATABASE_PASSWORD_MINIMUM_16_CHARS>
JWT_SECRET_KEY=<INJECT_RANDOM_SIGNING_MATERIAL_MINIMUM_32_BYTES>
# Encrypts staff TOTP seeds at rest. Generate with:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Losing it forces every staff member to re-enrol MFA; store it in the secret manager.
MFA_ENCRYPTION_KEY=<INJECT_URLSAFE_BASE64_32_BYTE_KEY>
# Keys the e-mail fingerprints kept in logs/audit instead of typed addresses.
# Dedicated secret (>=32 chars), distinct from JWT_SECRET_KEY and MFA_ENCRYPTION_KEY.
PRIVACY_FINGERPRINT_KEY=<INJECT_RANDOM_FINGERPRINT_KEY_MINIMUM_32_CHARS>
PASSWORD_RESET_EXPIRE_MINUTES=60
PUBLIC_DOMAIN=<INJECT_APPROVED_DNS_NAME>
ALLOWED_HOSTS=["<INJECT_APPROVED_DNS_NAME>"]
CORS_ORIGINS=["https://<INJECT_APPROVED_DNS_NAME>"]
METRICS_TOKEN=<INJECT_RANDOM_INTERNAL_METRICS_TOKEN>
GRAFANA_ADMIN_USER=<INJECT_GRAFANA_ADMIN_USER>
GRAFANA_ADMIN_PASSWORD=<INJECT_GRAFANA_ADMIN_PASSWORD>

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_RUN_ON_START=true
BACKUP_TIMEZONE=UTC
# Archive the private documents volume on the same schedule (after the database dump).
DOCUMENTS_BACKUP_ENABLED=true
OFFSITE_BACKUP_ENABLED=true
OFFSITE_S3_BUCKET=<INJECT_PRIVATE_BUCKET>
OFFSITE_S3_PREFIX=myvita
OFFSITE_S3_REGION=<INJECT_REGION>
OFFSITE_S3_ENDPOINT=<INJECT_ENDPOINT_IF_NOT_AWS>
OFFSITE_S3_SSE=AES256
OFFSITE_RETENTION_DAYS=30
# Client-side encryption of every off-site object (required). Public key(s)
# only, space or comma separated (e.g. one per founder). Generate on an
# operator laptop with `age-keygen -o myvita-backup.key`; keep that file in
# the password manager, never on the server. Restore needs it.
OFFSITE_AGE_RECIPIENT=<INJECT_AGE_PUBLIC_KEY_age1...>
AWS_ACCESS_KEY_ID=<INJECT_PREFIX_SCOPED_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<INJECT_PREFIX_SCOPED_SECRET_KEY>
AWS_SESSION_TOKEN=<INJECT_TEMPORARY_SESSION_TOKEN_IF_USED>

ALLOW_PUBLIC_CLINIC_ONBOARDING=false
ALLOW_PUBLIC_PATIENT_REGISTRATION=false
INVITATION_EXPIRE_HOURS=24
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000

# --- Human alert delivery (monitoring/alertmanager/render-and-run.sh, docs/operations.md) ---
# email | webhook | email+webhook. "unconfigured" is refused by scripts/production_preflight.sh.
ALERT_DELIVERY=<INJECT_email_OR_webhook_OR_email+webhook>
ALERT_EMAIL_TO=<INJECT_ONCALL_RECIPIENTS_COMMA_SEPARATED>
ALERT_EMAIL_FROM=<INJECT_ALERT_SENDER_ADDRESS>
ALERT_SMTP_SMARTHOST=<INJECT_SMTP_RELAY_HOST:587>
ALERT_SMTP_USERNAME=<INJECT_SMTP_RELAY_USER>
# Directory OUTSIDE the repository holding the files smtp_password, webhook_url and
# heartbeat_url (external dead man's switch). Readable by uid 65534; never commit it.
ALERT_SECRETS_DIR=<INJECT_ABSOLUTE_PATH_TO_ALERT_SECRETS_DIR>
# Directory with public_https.yml (see monitoring/targets/README.md).
MONITORING_TARGETS_DIR=<INJECT_ABSOLUTE_PATH_TO_MONITORING_TARGETS_DIR>

# --- Transactional e-mail for invitation and password-reset links (docs/email-delivery.md) ---
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=<INJECT_SMTP_RELAY_HOST>
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=<INJECT_SMTP_RELAY_USER>
SMTP_PASSWORD=<INJECT_SMTP_RELAY_PASSWORD>
EMAIL_FROM=<INJECT_NO_REPLY_SENDER_ON_A_VERIFIED_DOMAIN>
PUBLIC_APP_URL=https://<INJECT_APPROVED_DNS_NAME>
# Requires an approved identity-verification and abuse policy before enabling.
SELF_SERVICE_PASSWORD_RESET_ENABLED=false

# --- TLS certificate renewal (scripts/renew_tls_certificate.sh, docs/tls-certificates.md) ---
ACME_EMAIL=<INJECT_CERTIFICATE_CONTACT_ADDRESS>
TLS_CERT_DIR=<INJECT_ABSOLUTE_PATH_MOUNTED_AT_/etc/nginx/tls>
