# Leave empty (the default) for local dev — Vite's dev server proxies /api
# to the backend (see vite.config.ts) and, in production, the SPA and API
# are expected to share an origin (or sit behind the same reverse proxy).
#
# Set this only if the API genuinely lives on a different origin/subdomain
# in your deployment (e.g. api.myvita.pt while the app is on app.myvita.pt).
# Never put secrets here — everything in a Vite .env is bundled into the
# client-visible JS. This is a URL, not a credential, so that's fine.
VITE_API_BASE_URL=
