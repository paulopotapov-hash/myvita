    {"type":"timeseries","title":"Container CPU / memory","id":10,"gridPos":{"h":8,"w":8,"x":16,"y":13},"targets":[{"expr":"sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100","legendFormat":"CPU {{name}}"},{"expr":"sum by (name) (container_memory_working_set_bytes{name!=\"\"})","legendFormat":"Memory {{name}}"}]},
