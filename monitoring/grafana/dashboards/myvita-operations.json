    {"type":"timeseries","title":"Host CPU and memory","id":8,"gridPos":{"h":8,"w":8,"x":0,"y":13},"targets":[{"expr":"100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))","legendFormat":"CPU %"},{"expr":"100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)","legendFormat":"Memory %"}],"fieldConfig":{"defaults":{"unit":"percent","max":100,"min":0}}},
